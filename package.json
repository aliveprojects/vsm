{
  "name": "vsm-conductor",
  "version": "1.0.0",
  "private": true,
  "description": "Геймифицированный тренажёр проводников ВСМ-400",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "start": "npm run start -w backend",
    "build": "npm run build -w frontend && npm run build -w backend",
    "selfcheck": "npm run selfcheck -w backend",
    "smoke": "node scripts/smoke.mjs",
    "install:all": "npm install"
  },
  "workspaces": ["backend", "frontend"],
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
